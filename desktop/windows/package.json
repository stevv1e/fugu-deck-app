{
  "name": "fugu-deck-desktop",
  "version": "0.16.1",
  "private": true,
  "description": "Fugu Deck desktop client (Electron over Expo web export)",
  "main": "main.js",
  "author": "Fugu Deck",
  "scripts": {
    "test": "node --test net.test.js files.test.js update.test.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.ghostixel.fugudeck",
    "productName": "Fugu Deck",
    "protocols": [
      {
        "name": "Fugu Deck invitation",
        "schemes": [
          "fugudeck"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "files.js",
      "net.js",
      "update.js",
      "preload.js",
      "dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false
    }
  }
}
