{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fugu Deck",
  "version": "0.6.3",
  "identifier": "kz.fugudeck.desktop",
  "build": { "frontendDist": "../../mobile/dist" },
  "app": {
    "windows": [{ "label": "main", "title": "Fugu Deck", "width": 1280, "height": 820, "minWidth": 760, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self' tauri: ipc: http://ipc.localhost; img-src 'self' data: blob: tauri:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src ipc: http://ipc.localhost; frame-src 'self' about: data:"
    }
  },
  "plugins": { "deep-link": { "desktop": { "schemes": ["fugudeck"] } } },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "Fugu Deck",
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["Russian", "English"] } }
  }
}
