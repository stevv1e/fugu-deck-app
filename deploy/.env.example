# ===== Fugu Deck: скопируйте в deploy/.env и заполните =====

# Домен, на котором будет приложение (A-запись должна указывать на сервер)
DOMAIN=deck.example.com

# Откуда брать образы (заполняет CI; для ручной сборки можно не трогать)
REGISTRY=ghcr.io/your-github-login
IMAGE_TAG=latest

# --- Sakana ---
SAKANA_API_KEY=
SAKANA_BASE_URL=https://api.sakana.ai/v1
# Первая модель — по умолчанию. Переключаются в приложении кнопкой справа сверху.
MODELS=fugu-max-v1.0,fugu-ultra-v2.0
# Цены за 1M токенов [вход, выход, кэш] — для подсчёта расходов в приложении
PRICING_JSON={"fugu-max-v1.0": [2, 6, 0.25], "fugu-ultra-v2.0": [5, 30, 0.5]}

# --- Вход в приложение ---
# Логин владельца (у владельца все права; остальных пользователей он создаёт в приложении)
OWNER_USERNAME=owner
# Длинный пароль (генератор: openssl rand -base64 24)
APP_PASSWORD=
# Необязательно, но очень рекомендуется: 2FA. Сгенерировать:
#   python3 -c "import secrets,base64;print(base64.b32encode(secrets.token_bytes(20)).decode())"
# и добавить в Google Authenticator / Aegis как ключ.
TOTP_SECRET=
# Секрет подписи сессий (openssl rand -base64 48). Если пусто — сгенерируется сам.
JWT_SECRET=

# --- Git ---
# GitHub: Settings → Developer settings → Fine-grained tokens.
#   Права: Contents (RW), Pull requests (RW), Metadata (R), Actions (R), Administration (RW — только если нужно создавать репо)
GITHUB_TOKEN=
# GitLab: Preferences → Access tokens. Scope: api
GITLAB_TOKEN=
GITLAB_URL=https://gitlab.com

# Какие действия подтверждать: all | dangerous | none
APPROVAL_MODE=all

# Папка скилов. По умолчанию /data/skills (редактируется в приложении).
# Для GitOps: смонтируйте git-репозиторий со скилами (см. docker-compose.yml) и укажите /skills
# SKILLS_DIR=/skills
