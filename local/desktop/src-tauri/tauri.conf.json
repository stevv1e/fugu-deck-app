{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fugu Local",
  "version": "0.7.0",
  "identifier": "kz.fugudeck.local",
  "build": { "frontendDist": "../../dist", "devUrl": "http://localhost:8081" },
  "app": {
    "windows": [{ "label": "main", "title": "Fugu Local", "width": 1280, "height": 820, "minWidth": 760, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self' tauri: ipc: http://ipc.localhost; img-src 'self' data: blob: tauri:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "Fugu Deck",
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["Russian", "English"] } }
  }
}
