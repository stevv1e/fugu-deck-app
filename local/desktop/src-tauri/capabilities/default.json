{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Окно Fugu Local: только адреса провайдеров моделей и открытие ссылок в браузере",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.sakana.ai/*" },
        { "url": "https://api.anthropic.com/*" },
        { "url": "https://api.deepseek.com/*" },
        { "url": "https://api.openai.com/*" }
      ]
    }
  ]
}
